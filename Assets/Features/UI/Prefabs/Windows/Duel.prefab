      propertyPath: m_text
      value: "\u041F\u0430\u0441\u043E\u0432\u0430\u0442\u044C \u0438\u043B\u0438
        \u043D\u0435\u0442? \u2014 \u0440\u0435\u0448\u0438 \u0432 \u043D\u0430\u0447\u0430\u043B\u0435
        \u0445\u043E\u0434\u0430. \u041F\u0430\u0441 = \u0442\u044B \u043D\u0435
        \u0431\u0440\u043E\u0441\u0430\u0435\u0448\u044C, \u043D\u043E \u0438 \u044D\u0444\u0444\u0435\u043A\u0442\u044B
        \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0430 \u043D\u0430 \u0442\u0435\u0431\u044F
        \u043D\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442"
